"""Servidor HTTP que corre DENTRO del ladrillo EV3.

Solo usa la biblioteca estándar de Python (más `ev3dev2` para los motores, que
ya viene con ev3dev). No requiere pip install en el ladrillo: FastAPI necesita
Python 3.7+ y pydantic no tiene wheels para el ARM del EV3, mientras que
ev3dev-stretch trae Python 3.5.

    python3 main.py        # escucha en el puerto 8080

Contrato HTTP (el que consume ev3_backend/ev3_bridge.py):

    GET  /status        -> {connected, battery, motors[], sensors[]}
    POST /move          <- {motor, speed}      speed en % (-100..100)
    POST /stop          <- {motor} opcional; sin él, detiene los cuatro
    GET  /?cmd=...      interfaz heredada por query params (backend en Rust)
"""
import json
import os
import signal
from http.server import BaseHTTPRequestHandler, HTTPServer
from socketserver import ThreadingMixIn
from urllib.parse import urlparse, parse_qs

try:
    from ev3dev2.motor import LargeMotor, OUTPUT_A, OUTPUT_B, OUTPUT_C, OUTPUT_D  # type: ignore
except ImportError:  # pragma: no cover - solo ocurre fuera del ladrillo
    LargeMotor = None
    OUTPUT_A, OUTPUT_B, OUTPUT_C, OUTPUT_D = "outA", "outB", "outC", "outD"

MOTOR_PORTS = ["outA", "outB", "outC", "outD"]
SENSOR_PORTS = ["in1", "in2", "in3", "in4"]

# ─── Motores físicos ──────────────────────────────────────────────────────────
# Inicializamos los cuatro puertos con try-except para que el servidor arranque
# aunque los estudiantes olviden conectar algún cable.

_PORT_CONSTANTS = {
    "outA": OUTPUT_A,
    "outB": OUTPUT_B,
    "outC": OUTPUT_C,
    "outD": OUTPUT_D,
}

motors = {}
for _port, _const in _PORT_CONSTANTS.items():
    try:
        motors[_port] = LargeMotor(_const) if LargeMotor else None
    except Exception:
        motors[_port] = None


def normalize_port(port):
    """Acepta "A", "outA" o "ev3-ports:outA" y devuelve siempre "outA"."""
    p = str(port).strip().split(":")[-1]
    if not p.startswith("out"):
        p = "out" + p.upper()
    return p[:3] + p[3:].upper()


def get_motor(port):
    return motors.get(normalize_port(port))


def get_motor_by_index(idx):
    """Mapea el índice legacy que envía Rust (0=B, 1=D) al motor físico."""
    return motors.get("outB") if idx == 0 else motors.get("outD")


def apply_speed(port, speed):
    """Aplica una consigna en % a un motor. Devuelve (ok, velocidad_aplicada)."""
    motor = get_motor(port)
    if motor is None:
        return False, 0
    # ev3dev2 acepta velocidades de -100 a 100. Limitamos por seguridad.
    safe_speed = max(-100, min(100, int(speed)))
    if safe_speed == 0:
        motor.off()
    else:
        motor.on(safe_speed)
    return True, safe_speed


# ─── Lectura del estado real desde sysfs ──────────────────────────────────────
# Leemos directamente de /sys en lugar de usar ev3dev2 para no depender de que
# cada sensor esté instanciado con la clase correcta.

TACHO_DIR = "/sys/class/tacho-motor"
SENSOR_DIR = "/sys/class/lego-sensor"
BATTERY_FILE = "/sys/class/power_supply/lego-ev3-battery/voltage_now"

DRIVER_TO_TYPE = {
    "lego-ev3-touch": "Touch",
    "lego-ev3-color": "Color",
    "lego-ev3-us": "Ultrasonic",
    "lego-ev3-gyro": "Gyro",
    "lego-ev3-ir": "Infrared",
}


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def _read_number(path, default=0.0):
    raw = _read(path)
    try:
        return float(raw)
    except ValueError:
        return default


def _listdir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def read_motors():
    """Devuelve los 4 puertos de salida, marcando cuáles tienen motor conectado."""
    found = {}
    for node in _listdir(TACHO_DIR):
        base = "{}/{}".format(TACHO_DIR, node)
        port = _read("{}/address".format(base)).split(":")[-1]
        if not port:
            continue
        found[port] = {
            "port": port,
            "connected": True,
            "speed": int(_read_number("{}/speed".format(base))),
        }

    return [
        found.get(p, {"port": p, "connected": False, "speed": 0})
        for p in MOTOR_PORTS
    ]


def read_sensors():
    """Devuelve solo los sensores realmente conectados."""
    sensors = []
    for node in _listdir(SENSOR_DIR):
        base = "{}/{}".format(SENSOR_DIR, node)
        port = _read("{}/address".format(base)).split(":")[-1]
        if not port:
            continue
        driver = _read("{}/driver_name".format(base))
        sensors.append({
            "port": port,
            "sensor_type": DRIVER_TO_TYPE.get(driver, driver or "Unknown"),
            "value": _read_number("{}/value0".format(base)),
        })
    return sensors


def read_battery():
    """Voltaje en voltios (sysfs lo expone en microvoltios)."""
    # Sin separadores de millar en el literal: este archivo corre en el ladrillo,
    # donde el Python puede ser antiguo (los "_" numéricos requieren 3.6+)
    return round(_read_number(BATTERY_FILE) / 1000000.0, 2)


def read_status():
    """Telemetría completa del robot: motores, sensores y batería."""
    return {
        "connected": True,
        "battery": read_battery(),
        "motors": read_motors(),
        "sensors": read_sensors(),
    }


# ─── Servidor HTTP ────────────────────────────────────────────────────────────

class Ev3RequestHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"  # permite reutilizar la conexión TCP

    def _send_json(self, payload, status=200):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        # El puente ya añade CORS, pero esto permite depurar contra el robot
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def _read_json_body(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return {}
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}

    def do_GET(self):
        parsed = urlparse(self.path)

        if parsed.path == "/status":
            self._send_json(read_status())
            return

        if parsed.path == "/":
            self._send_json(self._legacy_command(parse_qs(parsed.query)))
            return

        self._send_json({"ok": False, "error": "ruta desconocida"}, status=404)

    def do_POST(self):
        parsed = urlparse(self.path)
        body = self._read_json_body()

        if parsed.path == "/move":
            port = normalize_port(body.get("motor", ""))
            ok, applied = apply_speed(port, body.get("speed", 0))
            if not ok:
                self._send_json({"ok": False, "port": port, "error": "motor no conectado"})
            else:
                self._send_json({"ok": True, "port": port, "speed": applied})
            return

        if parsed.path == "/stop":
            target = body.get("motor")
            targets = [normalize_port(target)] if target else MOTOR_PORTS
            stopped = []
            for port in targets:
                motor = motors.get(port)
                if motor is not None:
                    motor.off()
                    stopped.append(port)
            self._send_json({"ok": True, "stopped": stopped})
            return

        self._send_json({"ok": False, "error": "ruta desconocida"}, status=404)

    def _legacy_command(self, query):
        """Interfaz heredada por query params que espera el backend en Rust."""
        def _int(name, default=0):
            try:
                return int(query.get(name, [default])[0])
            except (TypeError, ValueError):
                return default

        cmd = query.get("cmd", [""])[0]
        idx = _int("idx", -1)

        if cmd == "motor":
            speed = _int("speed")
            motor = get_motor_by_index(idx)
            if motor:
                motor.on(max(-100, min(100, speed)))
            return {"ok": True, "cmd": cmd, "idx": idx, "speed": speed}

        if cmd == "stop":
            motor = get_motor_by_index(idx)
            if motor:
                motor.off()
            return {"ok": True, "cmd": cmd, "idx": idx}

        if cmd == "killpid":
            pid = _int("pid")
            if pid > 0:
                try:
                    # Envía la señal SIGKILL al proceso para detener la ejecución
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    # El proceso ya terminó o no existe
                    pass
            return {"ok": True, "cmd": cmd, "pid": pid}

        return {"ok": False, "error": "comando desconocido"}

    def log_message(self, fmt, *args):
        # El log por defecto va a stderr en cada peticion; con polling a 400 ms
        # eso inunda la consola del ladrillo. Silenciado a proposito.
        pass


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    """Un hilo por petición: un comando de motor no espera al polling."""
    daemon_threads = True
    allow_reuse_address = True


def serve(host="0.0.0.0", port=8080):
    server = ThreadedHTTPServer((host, port), Ev3RequestHandler)
    print("EV3 escuchando en http://{}:{}".format(host, port))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    serve()
